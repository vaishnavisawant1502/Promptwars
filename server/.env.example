PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/hydrosense
# Required: long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-before-running
JWT_EXPIRES_IN=7d
# Optional: only this email becomes admin on registration (otherwise the first account does)
ADMIN_EMAIL=
# Optional: set to false to close public registration after creating your accounts
ALLOW_REGISTRATION=true
